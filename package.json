{
	"name": "plakkert",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes && prettier --write src/lib/server/db/auth.schema.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify-svelte/lucide": "^1.0.66",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tiptap/core": "~3.35.0",
		"@tiptap/extension-list": "~3.35.0",
		"@tiptap/extensions": "~3.35.0",
		"@tiptap/pm": "~3.35.0",
		"@tiptap/starter-kit": "~3.35.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/turndown": "^5.0.6",
		"@vitest/browser-playwright": "^5.1.1",
		"@zip.js/zip.js": "^2.25.0",
		"auth": "^1.7.27",
		"better-auth": "~1.7.27",
		"dexie": "^4.4.7",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fflate": "^0.8.3",
		"globals": "^17.14.0",
		"libsodium-wrappers": "^0.8.4",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass-embedded": "^1.108.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"turndown": "^7.2.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"better-sqlite3": "^13.2.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
