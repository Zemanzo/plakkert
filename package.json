{
	"name": "plakkert",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes && prettier --write src/lib/server/db/auth.schema.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"auth": "^1.7.12",
		"better-auth": "~1.7.12",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass-embedded": "^1.106.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@friendofsvelte/tipex": "0.3.1",
		"@iconify-svelte/charm": "^1.0.2",
		"@iconify-svelte/lucide": "^1.0.66",
		"@tiptap/core": "~3.31.4",
		"@tiptap/extension-code-block": "~3.31.4",
		"@tiptap/extension-code-block-lowlight": "~3.31.4",
		"@tiptap/extension-floating-menu": "~3.31.4",
		"@tiptap/extension-image": "~3.31.4",
		"@tiptap/extension-list": "~3.31.4",
		"@tiptap/extensions": "~3.31.4",
		"@tiptap/pm": "~3.31.4",
		"@tiptap/starter-kit": "~3.31.4",
		"better-sqlite3": "^13.0.3",
		"dexie": "^4.4.7",
		"libsodium-wrappers": "^0.8.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
