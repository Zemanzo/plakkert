# Drizzle
DATABASE_URL=local.db

# Public origin of the app, e.g. https://plakkert.example.com. Read at build time (for CSRF checks)
# and at runtime (by Better Auth), so set it for both.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Who can create an account: "invite" (the default) only lets in people with INVITE_CODE, "open"
# lets in anyone, "closed" nobody. Invite only without an INVITE_CODE is closed. Read at runtime.
# Share an invite as a link: https://plakkert.example.com/register?invite=<code>
# Open here for local development; don't copy that to production.
REGISTRATION="open"
INVITE_CODE=""

# The name of the app, used for IndexedDB and other client-side storage
PUBLIC_APP_NAME="plakkert"
