# Drizzle
DATABASE_URL=local.db

# Public origin of the app, e.g. https://plakkert.example.com. Read at build time (for CSRF checks)
# and at runtime (by Better Auth), so set it for both.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Who can create an account: "invite" (the default) only lets in people with INVITE_CODE, "open"
# lets in anyone, "closed" nobody. Invite only without an INVITE_CODE is closed. Read at runtime.
# Share an invite as a link: https://plakkert.example.com/register?invite=<code>
# Open here for local development; don't copy that to production.
REGISTRATION="open"
INVITE_CODE=""

# Whether users can let MCP clients, such as AI assistants, use their notes: "on" or "off" (the
# default). Each user still has to turn it on for themselves in the settings, and chooses what
# each app may do. Needs ORIGIN to be the app's public HTTPS address. Read at runtime.
MCP="off"
# How many MCP clients can register from one IP address per hour (20 by default). Raise it when
# many users share one address. Read at runtime.
MCP_REGISTRATIONS_PER_HOUR=""

# The name of the app, used for IndexedDB and other client-side storage
PUBLIC_APP_NAME="plakkert"
